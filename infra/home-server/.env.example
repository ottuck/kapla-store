# 이 파일을 .env 로 복사해 값을 채운다(.env 는 .gitignore 대상이라 Git에 올라가지 않는다).
#   cp .env.example .env && chmod 600 .env
# Stripe 키는 여기에 두지 않는다. 키는 DB(woocommerce_stripe_settings)에 저장되며 DB 덤프와 함께 이전된다.

# 공개 주소(끝에 / 없이, https). WP_HOME / WP_SITEURL 로 쓰인다.
KAPLA_URL=https://kapla.portfolio-hub.dev

# 호스트에서 열 포트(127.0.0.1에만 bind). Cloudflare Tunnel 의 service 와 맞춘다.
KAPLA_PORT=8081

# DB. 비밀번호는 각각 `openssl rand -base64 24 | tr -d '/+='` 로 만든다.
KAPLA_DB_NAME=kapla
KAPLA_DB_USER=kapla
KAPLA_DB_PASSWORD=CHANGE_ME
KAPLA_DB_ROOT_PASSWORD=CHANGE_ME

# 컨테이너 메모리 상한(8GB 기기 기준 합계 1GB 이하가 목표).
KAPLA_WP_MEM_LIMIT=512m
KAPLA_DB_MEM_LIMIT=512m

# WordPress 인증 키와 salt 8개. 아래 한 줄 명령으로 .env 에 붙일 값을 만든다(키마다 다른 값이어야 한다).
#   for k in AUTH_KEY SECURE_AUTH_KEY LOGGED_IN_KEY NONCE_KEY AUTH_SALT SECURE_AUTH_SALT LOGGED_IN_SALT NONCE_SALT; do echo "WORDPRESS_$k=$(openssl rand -base64 48 | tr -d '\n')"; done
# 바꾸면 모든 로그인 세션이 풀린다.
WORDPRESS_AUTH_KEY=CHANGE_ME
WORDPRESS_SECURE_AUTH_KEY=CHANGE_ME
WORDPRESS_LOGGED_IN_KEY=CHANGE_ME
WORDPRESS_NONCE_KEY=CHANGE_ME
WORDPRESS_AUTH_SALT=CHANGE_ME
WORDPRESS_SECURE_AUTH_SALT=CHANGE_ME
WORDPRESS_LOGGED_IN_SALT=CHANGE_ME
WORDPRESS_NONCE_SALT=CHANGE_ME
